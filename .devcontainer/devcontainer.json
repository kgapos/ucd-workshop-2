{
  "name": "x402 workshop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:4-24-bookworm",
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "npm ci",
  "postAttachCommand": "gh codespace ports visibility 4021:public -c \"$CODESPACE_NAME\" >/dev/null 2>&1 || true",
  "forwardPorts": [
    4021
  ],
  "portsAttributes": {
    "4021": {
      "label": "Your x402 API",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "Class board",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
