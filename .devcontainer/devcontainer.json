{
  "name": "x402 workshop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:4-24-bookworm",
  "hostRequirements": {
    "cpus": 2
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "updateContentCommand": "npm ci",
  "postStartCommand": "gh codespace ports visibility 4021:public 4022:public 8080:public -c \"$CODESPACE_NAME\" || true",
  "forwardPorts": [
    4021,
    4022,
    8080
  ],
  "portsAttributes": {
    "4021": {
      "label": "Your x402 API",
      "onAutoForward": "silent"
    },
    "4022": {
      "label": "Facilitator (instructor only)",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "Class board (instructor only)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {
        "files.exclude": {
          ".instructor": true
        }
      }
    }
  }
}
