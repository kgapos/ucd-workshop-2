# Instructor wallets. Never commit this file. Create the keys with:
#   npm run wallet -- FUNDER_PRIVATE_KEY .instructor/.env
#   npm run wallet -- FACILITATOR_PRIVATE_KEY .instructor/.env
FUNDER_PRIVATE_KEY=
FACILITATOR_PRIVATE_KEY=
# Base Sepolia RPCs, comma-separated. Requests fail over from one to the next.
RPC_URL=https://base-sepolia-rpc.publicnode.com,https://sepolia.base.org,https://base-sepolia.gateway.tenderly.co,https://base-sepolia.api.onfinality.io/public
# Public URL of your facilitator, handed to students when they register
CLASS_FACILITATOR_URL=
# USDC_AMOUNT=1
# ETH_AMOUNT=0.0005
# BATCH=10
# FROM_BLOCK=
